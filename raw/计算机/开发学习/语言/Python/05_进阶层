    def complex_serialization():
        """复杂对象序列化"""
        
        print("🔧 复杂对象序列化:")
        
        # ✅ 自定义JSON编码器
        class AdvancedJSONEncoder(json.JSONEncoder):
            """高级JSON编码器"""
            
            def default(self, obj):
                """处理特殊对象类型"""
                
                # 处理日期时间
                if isinstance(obj, (datetime, date, time)):
                    return obj.isoformat()
                
                # 处理Decimal
                if isinstance(obj, Decimal):
                    return float(obj)
                
                # 处理枚举
                if isinstance(obj, Enum):
                    return obj.value
                
                # 处理UUID
                if isinstance(obj, uuid.UUID):
                    return str(obj)
                
                # 处理路径对象
                if isinstance(obj, Path):
                    return str(obj)
                
                # 处理字节
                if isinstance(obj, bytes):
                    return base64.b64encode(obj).decode('utf-8')
                
                # 处理集合类型
                if hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes)):
                    try:
                        return list(obj)
                    except TypeError:
                        pass
                
                # 处理自定义对象(有to_dict方法)
                if hasattr(obj, 'to_dict'):
                    return obj.to_dict()
                
                # 处理字典类型(保持键的顺序)
                if isinstance(obj, OrderedDict):
                    return dict(obj)
                
                # 递归处理对象属性
                if hasattr(obj, '__dict__'):
                    return {
                        '_type': type(obj).__name__,
                        '_module': type(obj).__module__,
                        **_safe_dict(obj.__dict__)
                    }
                
                return super().default(obj)
        
        def _safe_dict(obj_dict):
            """安全地转换字典"""
            result = {}
            for key, value in obj_dict.items():
                try:
                    # 递归处理嵌套对象
                    json.dumps(value, cls=AdvancedJSONEncoder)
                    result[key] = value
                except TypeError:
                    # 无法序列化的值转换为字符串
                    result[key] = str(value)
            return result
        
        # ✅ 自定义JSON解码器
        class AdvancedJSONDecoder(json.JSONDecoder):
            """高级JSON解码器"""
            
            def __init__(self, *args, **kwargs):
                json.JSONDecoder.__init__(
                    self, object_hook=self.object_hook, *args, **kwargs)
                self.type_map = {}
            
            def register_type(self, type_name: str, constructor: Callable):
                """注册类型构造器"""
                self.type_map[type_name] = constructor
            
            def object_hook(self, obj):
                """对象钩子函数"""
                # 处理自定义类型标识
                if isinstance(obj, dict) and '_type' in obj and '_module' in obj:
                    type_name = obj['_type']
                    obj_dict = {k: v for k, v in obj.items() if not k.startswith('_')}
                    
                    # 尝试进行类型映射
                    if type_name in self.type_map:
                        constructor = self.type_map[type_name]
                        return constructor(**obj_dict)
                
                return obj
        
