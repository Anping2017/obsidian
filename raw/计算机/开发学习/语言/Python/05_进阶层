# ✅ 高性能JSON处理框架
class JSONProcessor:
    """高性能JSON处理器"""
    
    def __init__(self):
        self.encoder = AdvancedJSONEncoder()
        self.decoder = AdvancedJSONDecoder()
    
    def process_large_file(self, filepath: str, chunk_size: int = 1000):
        """处理大JSON文件"""
        
        with open(filepath, 'r') as f:
            with ijson.parse_items(f.read()) as items:
                processed_count = 0
                batch = []
                
                for item in items:
                    batch.append(self._process_item(item))
                    processed_count += 1
                    
                    if len(batch) >= chunk_size:
                        yield self._process_batch(batch)
                        batch = []
                
                if batch:
                    yield self._process_batch(batch)
                
                print(f"处理完成，总计: {processed_count} 个项目")
    
    def _process_item(self, item):
        """单个项目处理"""
        return item  # 子类重写
    
    def _process_batch(self, batch):
        """批处理"""
        return batch  # 子类重写
