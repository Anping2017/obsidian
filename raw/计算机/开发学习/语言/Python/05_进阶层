# ✅ 环境化配置管理
class JSONConfig:
    """JSON配置管理器"""
    
    def __init__(self, base_config: str, env_specific: Optional[str] = None):
        self.config = self._load_config(base_config)
        
        if env_specific:
            env_config = self._load_config(env_specific)
            self.config = self._merge_configs(self.config, env_config)
    
    def _load_config(self, config_file: str) -> dict:
        """加载配置文件"""
        with open(config_file, 'r') as f:
            return json.load(f)
    
    def _merge_configs(self, base: dict, override: dict) -> dict:
        """合并配置"""
        result = base.copy()
        for key, value in override.items():
            if key in result and isinstance(result[key], dict) and isinstance(value, dict):
                result[key] = self._merge_configs(result[key], value)
            else:
                result[key] = value
        return result
    
    def get(self, key_path: str, default=None):
        """获取配置值"""
        keys = key_path.split('.')
        value = self.config
        
        for key in keys:
            if isinstance(value, dict) and key in value:
                value = value[key]
            else:
                return default
        
        return value
