# ✅ JSON数据处理管道
class JSONDataProcessor:
    """JSON数据处理器"""
    
    @staticmethod
    def transformation_techniques():
        """数据转换技术"""
        
        print("\n🔄 JSON数据转换技术:")
        
        # ✅ 数据清洗管道
        class JSONDataCleaner:
            """JSON数据清洗器"""
            
            def __init__(self):
                self.rules = []
            
            def add_rule(self, rule_func: Callable):
                """添加清洗规则"""
                self.rules.append(rule_func)
            
            def clean(self, data: Union[dict, list]) -> Union[dict, list]:
                """清洗数据"""
                if isinstance(data, dict):
                    return self._clean_dict(data)
                elif isinstance(data, list):
                    return self._clean_list(data)
                else:
                    return data
            
            def _clean_dict(self, obj: dict) -> dict:
                """清洗字典"""
                cleaned = {}
                for key, value in self._clean_dict_items(obj.items()):
                    cleaned[key] = value
                return cleaned
            
            def _clean_dict_items(self, items):
                """清洗字典项"""
                for key, value in items:
                    # 跳过空值和None
                    if value is None or value == "":
                        continue
                    
                    # 应用清洗规则
                    cleaned_value = value
                    for rule in self.rules:
                        cleaned_value = rule(cleaned_value)
                        if cleaned_value is None:
                            break
                    
                    if cleaned_value is not None:
                        yield key, cleaned_value
            
            def _clean_list(self, obj: list) -> list:
                """清洗列表"""
                cleaned = []
                for item in obj:
                    cleaned_item = self.clean(item)
                    if cleaned_item is not None:
                        cleaned.append(cleaned_item)
                return cleaned
        
        # ✅ 数据验证器
        class JSONValidator:
            """JSON数据验证器"""
            
            def __init__(self):
                self.schemas = {}
            
            def add_schema(self, name: str, schema: dict):
                """添加Schema"""
                jsonschema.Draft7Validator.check_schema(schema)
                self.schemas[name] = schema
            
            def validate(self, data: Any, schema_name: str) -> Dict[str, Any]:
                """验证数据"""
                if schema_name not in self.schemas:
                    raise ValueError(f"Unknown schema: {schema_name}")
                
                validator = jsonschema.Draft7Validator(self.schemas[schema_name])
                
                try:
                    validator.validate(data)
                    return {"valid": True, "errors": []}
                except jsonschema.exceptions.ValidationError as e:
                    return {
                        "valid": False, 
                        "errors": [{
                            "message": e.message,
                            "path": list(e.absolute_path),
                            "value": e.instance
                        }]
                    }
        
        # ✅ 数据转换器
        class JSONTransformer:
            """JSON数据转换器"""
            
            def __init__(self):
                self.transformations = {}
            
            def add_transformation(self, name: str, transform_func: Callable):
                """添加转换函数"""
                self.transformations[name] = transform_func
            
            def transform(self, data: Any, transformations: List[str]) -> Any:
                """应用转换"""
                result = data
                for transform_name in transformations:
                    if transform_name in self.transformations:
                        result = self.transformations[transform_name](result)
                return result
            
            def batch_transform(self, data_list: List[Any], transformation: str) -> List[Any]:
                """批量转换"""
                if transformation not in self.transformations:
                    raise ValueError(f"Unknown transformation: {transformation}")
                
                transform_func = self.transformations[transformation]
                return [transform_func(item) for item in data_list]
        
        # ✅ 测试数据处理管道
        # 创建测试数据
        test_data = {
            "users": [
                {"name": "  Alice  ", "age": "25", "email": "alice@example.com", "score": "85.5"},
                {"name": "Bob", "age": 30, "email": "bob@example.com", "score": 92.0},
                {"name": "", "age": "", "email": "", "score": None},  # 无效数据
                {"name": "Charlie", "age": 35, "email": "charlie@test.com", "score": "78.2"}
            ]
        }
        
        print("原始数据:")
        print(json.dumps(test_data, indent=2, ensure_ascii=False))
        
        # 数据清洗
        cleaner = JSONDataCleaner()
        cleaner.add_schema(rule=lambda x: x.strip() if isinstance(x, str) else x)  # 去除空格
        cleaner.add_schema(rule=lambda x: int(x) if isinstance(x, str) and x.isdigit() else x)  # 转换数字
        
        cleaned_data = cleaner.clean(test_data)
        print("\n清洗后数据:")
        print(json.dumps(cleaned_data, indent=2, ensure_ascii=False))
        
        # 数据验证Schema
        user_schema = {
            "type": "object",
            "properties": {
                "name": {"type": "string", "minLength": 1},
                "age": {"type": "integer", "minimum": 1},
                "email": {"type": "string", "format": "email"},
                "score": {"type": "number", "minimum": 0, "maximum": 100}
            },
            "required": ["name", "age", "email", "score"]
        }
        
        validator = JSONValidator()
        validator.add_schema("user", user_schema)
        
        print("\n数据验证:")
        for i, user in enumerate(cleaned_data.get("users", [])):
            validation_result = validator.validate(user, "user")
            status = "✅" if validation_result["valid"] else "❌"
            print(f"用户{i+1}: {status}")
            if not validation_result["valid"]:
                for error in validation_result["errors"]:
                    print(f"  错误: {error['message']} (路径: {error['path']})")
        
        # 数据转换
        transformer = JSONTransformer()
        transformer.add_transformation("normalize_name", lambda x: x.lower().replace(" ", "_") if isinstance(x, dict) else x)
        transformer.add_transformation("add_score_level", lambda x: {
            **x, 
            "score_level": "high" if x.get("score", 0) >= 80 else "low"
        } if isinstance(x, dict) else x)
        
        transformed_data = transformer.transform(cleaned_data, ["add_score_level"])
        print("\n转换后数据:")
        print(json.dumps(transformed_data, indent=2, ensure_ascii=False))
        
        return cleaned_data, validator, transformer

# ✅ JSON与API集成
class JSONAPIPatterns:
    """JSON API模式"""
    
    @staticmethod
    def api_json_patterns():
        """API JSON模式"""
        
        print("\n🌐 API JSON模式:")
        
        # ✅ REST API响应格式
        class APIResponse:
            """标准化API响应"""
            
            def __init__(self, data=None, message=None, success=True, code=200):
                self.data = data
                self.message = message
                self.success = success
                self.code = code
                self.timestamp = datetime.now()
                self.request_id = str(uuid.uuid4())
            
            def to_json(self, **kwargs):
                """转换为JSON"""
                response = {
                    "success": self.success,
                    "code": self.code,
                    "message": self.message,
                    "data": self.data,
                    "timestamp": self.timestamp.isoformat(),
                    "request_id": self.request_id
                }
                
                return json.dumps(response, cls=AdvancedJSONEncoder, **kwargs)
            
            @classmethod
            def success_response(cls, data=None, message="Success"):
                """成功响应"""
                return cls(data=data, message=message, success=True, code=200)
            
            @classmethod
            def error_response(cls, message="Error", code=400, data=None):
                """错误响应"""
                return cls(data=data, message=message, success=False, code=code)
        
        # ✅ 分页响应格式
        class PaginatedResponse(APIResponse):
            """分页响应"""
            
            def __init__(self, data=None, page=1, per_page=10, total=0, **kwargs):
                super().__init__(data=data, **kwargs)
                self.page = page
                self.per_page = per_page
                self.total = total
                self.pages = (total + per_page - 1) // per_page
            
            def to_json(self, **kwargs):
                """转换为JSON"""
                response = super().to_json(**kwargs)
                response_dict = json.loads(response)
                
                response_dict.update({
                    "pagination": {
                        "page": self.page,
                        "per_page": self.per_page,
                        "total": self.total,
                        "pages": self.pages,
                        "has_next": self.page < self.pages,
                        "has_prev": self.page > 1
                    }
                })
                
                return json.dumps(response_dict, **kwargs)
        
        # ✅ API错误处理
        class APIError(Exception):
            """API错误基类"""
            
            def __init__(self, message, code=400, details=None):
                self.message = message
                self.code = code
                self.details = details or {}
                super().__init__(message)
            
            def to_response(self):
                """转换为错误响应"""
                return APIResponse.error_response(
                    message=self.message,
                    code=self.code,
                    data=self.details
                )
        
        class ValidationError(APIError):
            """验证错误"""
            def __init__(self, field_errors):
                super().__init__(
                    message="Validation failed",
                    code=422,
                    details={"field_errors": field_errors}
                )
        
        class NotFoundError(APIError):
            """未找到错误"""
            def __init__(self, resource_type="Resource"):
                super().__init__(
                    message=f"{resource_type} not found",
                    code=404
                )
        
        # ✅ 数据模型与JSON映射
        class JSONSerializable:
            """JSON可序列化基类"""
            
            def __init__(self, **kwargs):
                for key, value in kwargs.items():
                    setattr(self, key, value)
            
            def to_dict(self):
                """转换为字典"""
                result = {}
                for key, value in self.__dict__.items():
                    if not key.startswith('_'):
                        if isinstance(value, datetime):
                            result[key] = value.isoformat()
                        elif isinstance(value, (list, tuple)):
                            result[key] = [item.to_dict() if hasattr(item, 'to_dict') else item for item in value]
                        elif hasattr(value, 'to_dict'):
                            result[key] = value.to_dict()
                        else:
                            result[key] = value
                return result
            
            @classmethod
            def from_dict(cls, data: dict):
                """从字典创建"""
                return cls(**data)
            
            def to_json(self, **kwargs):
                """转换为JSON"""
                return json.dumps(self.to_dict(), **kwargs)
        
        # ✅ 用户模型示例
        class User(JSONSerializable):
            """用户模型"""
            
            def __init__(self, name, email, age=None, created_at=None, **kwargs):
                super().__init__(**kwargs)
                self.name = name
                self.email = email
                self.age = age
                self.created_at = created_at or datetime.now()
        
