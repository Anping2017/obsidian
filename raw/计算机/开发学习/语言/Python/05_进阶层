        def streaming_json_processing():
            """流式JSON处理"""
            
            # 创建大文件(模拟)
            large_data = [
                {'id': i, 'data': f'item_{i}', 'value': i * 2.5}
                for i in range(10000)
            ]
            
            print("🔍 流式处理演示:")
            
            # 使用ijson进行流式处理
            def process_json_stream():
                """流式处理JSON数组"""
                
                # 模拟写文件
                filename = 'large_data.json'
                with open(filename, 'w') as f:
                    json.dump(large_data, f)
                
                # 流式读取
                processed_items = []
                
                try:
                    with open(filename, 'rb') as f:
                        parser = ijson.parse(f)
                        current_item = {}
                        
                        for prefix, event, value in parser:
                            if event == 'start_map':
                                current_item = {}
                            elif event == 'string' or event == 'number':
                                key = prefix.split('.')[-1]
                                current_item[key] = value
                            elif event == 'end_map':
                                processed_items.append(current_item)
                                
                                # 在流式处理中，可以随时处理每个项目
                                if len(processed_items) % 1000 == 0:
                                    print(f"已处理 {len(processed_items)} 个项目")
                
                finally:
                    # 清理文件
                    Path(filename).unlink(missing_ok=True)
                
                print(f"流式处理完成，总计: {len(processed_items)} 个项目")
                return processed_items
            
            # ✅ 增量解析技术
            class IncrementalJSONParser:
                """增量JSON解析器"""
                
                def __init__(self):
                    self.buffer = ""
                    self.parser = None
                    self.complete_items = []
                
                def feed(self, data: str):
                    """输入数据"""
                    self.buffer += data
                    self._parse_complete_items()
                
                def _parse_complete_items(self):
                    """解析完整的JSON对象"""
                    while self._has_complete_item():
                        try:
                            # 尝试解析第一个完整对象
                            decoder = json.JSONDecoder()
                            obj, end_idx = decoder.raw_decode(self.buffer)
                            self.complete_items.append(obj)
                            self.buffer = self.buffer[end_idx:].lstrip('\r\n \t')
                        except ValueError:
                            break
                
                def _has_complete_item(self):
                    """检查是否有完整对象"""
                    self.buffer = self.buffer.lstrip('\r\n \t')
                    if not self.buffer:
                        return False
                    
                    # 简单检查: 确保括号匹配
                    if self.buffer.startswith('['):
                        bracket_count = 0
                        for char in self.buffer:
                            if char == '[':
                                bracket_count += 1
                            elif char == ']':
                                bracket_count -= 1
                                if bracket_count == 0:
                                    return True
                            elif bracket_count == 0:
                                # 在顶层遇到了非括号字符，可能有问题
                                break
                    
                    return False
                
                def get_complete_items(self):
                    """获取已完成的解析对象"""
                    items = self.complete_items[:]
                    self.complete_items.clear()
                    return items
            
            # 性能测试
            benchmark_serialization()
            streaming_json_processing()
            
            # 增量解析测试
            incremental_parser = IncrementalJSONParser()
            
            # 模拟网络流数据(分块接收)
